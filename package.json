{
  "name": "rocket-chat-mcp",
  "version": "0.3.0",
  "description": "MCP server exposing Rocket.Chat messaging capabilities as tools for LLM agents",
  "type": "module",
  "scripts": {
    "build": "npm run build:ui && tsc",
    "build:ui": "vite build -c ui/composer/vite.config.ts",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "release": "semantic-release"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@rocket.chat/message-parser": "^0.31.35",
    "express": "^5.2.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semantic-release": "^25.0.3",
    "testcontainers": "^12.0.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.56.0",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.0"
  }
}
